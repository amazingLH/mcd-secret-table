# 仅在本机使用；不要把真实 Token 提交到 GitHub。
MCD_MCP_TOKEN=YOUR_MCD_MCP_TOKEN
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
# Node.js 22+；npm run dev / npm start / npm run agent:verify / npm run model:check
# 会读取项目 .env.local，也接受系统/进程环境变量（后者优先）。不自动读取 .env。
# 此处默认模型不代表你的账户一定有免费额度。
AGENT_MODEL=deepseek-v4.1-flash
# 兼容旧配置 QWEN_MODEL；两者同时存在时 AGENT_MODEL 优先。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认禁止真实调用。核实该对话模型的免费额度/有效期/地域和付费设置后，
# 才将下面变量设为与实际模型完全相同的模型名（更换模型需重新确认）。
# 该确认不是余额查询，也不保证永远免费；实际抵扣和扣费由百炼控制。
# DASHSCOPE_BILLING_CONFIRMED_MODEL=deepseek-v4.1-flash
